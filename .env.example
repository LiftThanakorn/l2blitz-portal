# ============================================================================
# L2BLITZ PVP — Lineage II High Five Instant PvP Portal Environment Config
# ============================================================================

# 1. Runtime & Server Mode
NODE_ENV=development
PORT=3001
CORS_ORIGIN=https://l2blitz.in.th,http://localhost:5173

# 2. Demo Fixture Mode
# - Set DEMO_MODE=true during development when GameServer is not connected.
# - Set DEMO_MODE=false in production (production strictly never returns fake numbers).
DEMO_MODE=true

# 3. MySQL / MariaDB Read-Only Connection (L2J_Mobius_CT_2.6_HighFive)
# IMPORTANT: Create a dedicated MySQL user with SELECT-only privileges!
# Do NOT expose port 3306 to the public internet (bind to 127.0.0.1).
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=l2blitz_readonly
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_GAME_NAME=l2jmobius_h5
DB_LOGIN_NAME=l2jmobius_login
DB_POOL_LIMIT=4

# 4. GameServer & LoginServer TCP Probe (Distinguishes DB Online vs GameServer Online)
GAMESERVER_HOST=127.0.0.1
GAMESERVER_PORT=7777
LOGINSERVER_HOST=127.0.0.1
LOGINSERVER_PORT=2106
TCP_PROBE_TIMEOUT_MS=1500

# 5. Ranking Integrity Filters (Exclude GMs, Dev/Test Accounts & Test Characters)
EXCLUDED_ACCOUNT_NAMES=admin,gm,test,test01,dev,l2blitz_admin
EXCLUDED_CHAR_NAMES=Admin,GM,TestChar,BlitzGM

# 6. Optional Feature Toggles
ENABLE_OLYMPIAD_HEROES=true
ENABLE_CASTLE_OWNERSHIP=true
ENABLE_TVT_RANKINGS=false

# 7. Server Rates Override
RATE_EXP=1000
RATE_SP=1000
RATE_ADENA=50
RATE_DROP=10
RATE_SPOIL=15
RATE_QUEST_DROP=5
RATE_RAID_DROP=1
SAFE_ENCHANT=4
MAX_ENCHANT_WEAPON=16
MAX_ENCHANT_ARMOR=12
MAX_ENCHANT_JEWELRY=12

# 8. Frontend Vite Build Config (for Cloudflare Pages)
VITE_API_BASE_URL=/api
VITE_DEMO_FALLBACK=false
