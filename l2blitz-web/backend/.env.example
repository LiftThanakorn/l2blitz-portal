# L2BLITZ PVP Backend Environment Configuration
# Copy this file to `/opt/l2blitz-web/backend/.env` on your Ubuntu VPS.

PORT=4000
NODE_ENV=production

# Set DB_ENABLE=true ONLY when connecting to the live L2J Mobius CT 2.6 MariaDB/MySQL server.
# Keep USE_DEV_FIXTURES=false in production so fake numbers never appear.
DB_ENABLE=false
USE_DEV_FIXTURES=false

# Read-Only MySQL / MariaDB User Credentials for L2J Mobius High Five
# GRANT SELECT ON l2jmobius.* TO 'l2blitz_ro'@'127.0.0.1' IDENTIFIED BY 'strong_password';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=l2blitz_ro
DB_PASSWORD=change_me_in_production
DB_NAME=l2jgs
